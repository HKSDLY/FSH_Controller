<Window x:Class="FSH_Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSH_Controller"
        mc:Ignorable="d"
        Title="RS FSH Advanced Controller" 
        MinHeight="800" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Connection Panel -->
        <GroupBox Header="Connection Settings" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Resource Address:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtResourceAddress" Text="TCPIP::172.17.75.1::INSTR" Grid.Column="1" Margin="5" MinWidth="150"/>
                <Button x:Name="btnConnect" Content="Connect" Grid.Column="2" Width="100" Margin="5" Click="btnConnect_Click"/>
                <Button x:Name="btnCheckRos" Content="Check ROS" Grid.Row="1" Grid.Column="0" Width="100" Margin="5" Click="btnCheckRos_Click"/>
                <Button x:Name="btnTestMove" Content="Test Move" Grid.Row="1" Grid.Column="1" Width="120" Margin="5" HorizontalAlignment="Left" Click="btnTestMove_Click"/>
            </Grid>
        </GroupBox>

        <!-- Configuration Tabs -->
        <TabControl Grid.Row="1" Margin="0,10">
            <TabItem Header="Frequency Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Center Frequency:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtCenterFreq" Text="4.125GHz" Grid.Row="0" Grid.Column="1" Margin="5" MinWidth="100"/>

                        <TextBlock Text="Span:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtSpan" Text="3.45GHz" Grid.Row="1" Grid.Column="1" Margin="5" MinWidth="100"/>

                        <TextBlock Text="Sweep Time:" Grid.Row="2" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtSweepTime" Text="44ms" Grid.Row="2" Grid.Column="1" Margin="5" MinWidth="100"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Bandwidth Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="RBW:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtRBW" Text="5MHz" Grid.Row="0" Grid.Column="1" Margin="5" MinWidth="100"/>

                        <TextBlock Text="VBW:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtVBW" Text="3MHz" Grid.Row="1" Grid.Column="1" Margin="5" MinWidth="100"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Amplitude Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Reference Level:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtRefLevel" Text="122.7" Grid.Row="0" Grid.Column="1" Margin="5" MinWidth="100"/>

                        <TextBlock Text="Attenuation:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <TextBox x:Name="txtAttenuation" Text="0dB" Grid.Row="1" Grid.Column="1" Margin="5" MinWidth="100"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Transducer Settings" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Transducer File:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <ComboBox x:Name="cmbTransducer" Grid.Row="0" Grid.Column="1" Margin="5" MinWidth="150">
                            <ComboBoxItem Content="TSEMF-B2_typical.isotrd"/>
                            <ComboBoxItem Content="TSEMF-B2_typical_RSEMF26_4823_101850.isotrd"/>
                            <ComboBoxItem Content="HE400A-UWB.pritrd" IsSelected="True"/>
                        </ComboBox>
                        <CheckBox x:Name="chkTransducerEnabled" Content="Enable" Grid.Row="0" Grid.Column="2" Margin="5" IsChecked="True"/>

                        <!-- Isotropic Antenna Settings -->
                        <GroupBox Header="Isotropic Antenna" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                            <StackPanel>
                                <CheckBox x:Name="chkIsotropicAntenna" Content="Enable Isotropic Antenna" Margin="5" Checked="chkIsotropicAntenna_Checked" Unchecked="chkIsotropicAntenna_Unchecked"/>

                                <StackPanel Orientation="Horizontal" Margin="5,0">
                                    <TextBlock Text="Measurement Mode:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <RadioButton x:Name="rbAuto" Content="AUTO" GroupName="AntennaMode" Margin="5,0" IsChecked="True"/>
                                    <RadioButton x:Name="rbX" Content="X" GroupName="AntennaMode" Margin="5,0"/>
                                    <RadioButton x:Name="rbY" Content="Y" GroupName="AntennaMode" Margin="5,0"/>
                                    <RadioButton x:Name="rbZ" Content="Z" GroupName="AntennaMode" Margin="5,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Text="Detection Mode:" Grid.Row="2" Grid.Column="0" Margin="5"/>
                        <ComboBox x:Name="cmbDetectionMode" Grid.Row="2" Grid.Column="1" Margin="5" MinWidth="120">
                            <ComboBoxItem Content="RMS (Default)" Tag="RMS" IsSelected="True"/>
                            <ComboBoxItem Content="Auto Peak" Tag="APE"/>
                            <ComboBoxItem Content="Max Peak" Tag="POS"/>
                            <ComboBoxItem Content="Min Peak" Tag="NEG"/>
                            <ComboBoxItem Content="Sample" Tag="SAMP"/>
                        </ComboBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Marker Settings" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <TextBlock Text="Marker 1:" Margin="5" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMarker1" Text="2.44175GHz" Width="100" Margin="5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="1">
                            <TextBlock Text="Marker 2:" Margin="5" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMarker2" Text="3.5GHz" Width="100" Margin="5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="2">
                            <TextBlock Text="Marker 3:" Margin="5" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMarker3" Text="4.88GHz" Width="100" Margin="5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="3">
                            <TextBlock Text="Marker 4:" Margin="5" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMarker4" Text="5.25GHz" Width="100" Margin="5"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="4">
                            <TextBlock Text="Marker 5:" Margin="5" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMarker5" Text="5.66GHz" Width="100" Margin="5"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- New Electric Field Strength Tab -->
            <TabItem Header="Electric Field Strength" Background="SkyBlue">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Measurement Information -->
                        <GroupBox Header="Measurement Details" Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Venue:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                                <TextBox x:Name="txtVenue" Text="t2b.2f" Grid.Row="0" Grid.Column="1" Margin="5" MinWidth="80"/>

                                <TextBlock Text="Test Case:" Grid.Row="0" Grid.Column="2" Margin="5"/>
                                <TextBox x:Name="txtTestCase" Text="c8" Grid.Row="0" Grid.Column="3" Margin="5" MinWidth="80"/>

                                <TextBlock Text="Antenna Model:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                                <TextBox x:Name="txtAntennaModel" Text="HE400-UWB" Grid.Row="1" Grid.Column="1" Margin="5" MinWidth="80"/>

                                <TextBlock Text="Position:" Grid.Row="1" Grid.Column="2" Margin="5"/>
                                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox x:Name="txtPositionPrefix" Text="A" Width="30" Margin="5,5,0,5"/>
                                    <TextBox x:Name="txtPositionNumber" Text="001" Width="50" Margin="0,5,5,5" 
                                             PreviewTextInput="NumberValidationTextBox"/>
                                </StackPanel>

                                <TextBlock Text="Max Hold Time (s):" Grid.Row="2" Grid.Column="0" Margin="5"/>
                                <TextBox x:Name="txtMaxHoldTime" Text="60" Grid.Row="2" Grid.Column="1" Margin="5" MinWidth="50"/>

                                <CheckBox x:Name="chkIncludeTimestamp" Content="Include Timestamp" Grid.Row="2" Grid.Column="2" Margin="5" IsChecked="False"/>
                            </Grid>
                        </GroupBox>

                        <!-- Measurement Type -->
                        <GroupBox Header="Measurement Type" Grid.Row="1">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="cmbMeasurementType" Width="120" Margin="5" SelectedIndex="0">
                                    <ComboBoxItem Content="Single"/>
                                    <ComboBoxItem Content="Multiple"/>
                                </ComboBox>

                                <TextBlock Text="Iterations:" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtIterations" Text="6" Width="50" Margin="5" IsEnabled="True"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- File Saving Options -->
                        <GroupBox Header="File Saving" Grid.Row="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="chkSaveCSV" Grid.Row="0" Grid.Column="0" Content="Save CSV Data" Margin="5" IsChecked="True"/>
                                <TextBlock Text="CSV Path:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtCsvPath" Text="\Public\Datasets\" Grid.Row="1" Grid.Column="1" Margin="5"/>

                                <CheckBox x:Name="chkSavePNG" Grid.Row="0" Grid.Column="1" Content="Save Screenshot" Margin="5" IsChecked="True"/>
                                <TextBlock Text="PNG Path:" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtPngPath" Text="\Public\Screen Shots\" Grid.Row="3" Grid.Column="1" Margin="5"/>
                            </Grid>
                        </GroupBox>

                        <!-- Measurement Controls -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="btnRunSingle" Content="Run Single" Width="100" Margin="5" Click="btnRunSingle_Click"/>
                            <Button x:Name="btnRunMultiple" Content="Run Multiple" Width="100" Margin="5" Click="btnRunMultiple_Click"/>
                            <Button x:Name="btnStopMeasurement" Content="Stop" Width="100" Margin="5" Click="btnStopMeasurement_Click" IsEnabled="False"/>
                        </StackPanel>

                        <!-- Progress Display -->
                        <GroupBox Header="Measurement Progress" Grid.Row="4">
                            <StackPanel>
                                <ProgressBar x:Name="progressMeasurement" Height="20" Margin="5"/>
                                <TextBlock x:Name="txtProgressStatus" Margin="5" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtRemainingTime" Margin="5"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Measurement Log -->
                        <GroupBox Header="Measurement Log" Grid.Row="5">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnCopyLog" Content="Copy Log" Width="80" Margin="5" Click="btnCopyLog_Click"/>
                                    <Button x:Name="btnSaveLog" Content="Save Log" Width="80" Margin="5" Click="btnSaveLog_Click"/>
                                </StackPanel>
                                <TextBox x:Name="txtMeasurementLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                         TextWrapping="Wrap" Height="120"/>
                            </DockPanel>
                        </GroupBox>

                        <!-- Movement Control -->
                        <GroupBox Header="Movement Control" Grid.Row="6" Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Fine-Tune Movement -->
                                <TextBlock Text="Fine-Tune (cm):" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtFineTuneCm" Text="5" Grid.Row="0" Grid.Column="1" Width="50" Margin="5" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="btnMoveForwardCm" Content="Forward" Width="80" Margin="5" Click="btnMoveForwardCm_Click"/>
                                    <Button x:Name="btnMoveBackwardCm" Content="Backward" Width="80" Margin="5" Click="btnMoveBackwardCm_Click"/>
                                </StackPanel>

                                <!-- Distance Movement -->
                                <TextBlock Text="Distance (m):" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtMoveDistance" Text="1.0" Grid.Row="1" Grid.Column="1" Width="50" Margin="5" HorizontalAlignment="Left"/>

                                <TextBlock Text="Velocity (m/s):" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtMoveVelocity" Text="0.1" Grid.Row="2" Grid.Column="1" Width="50" Margin="5" HorizontalAlignment="Left"/>

                                <Button x:Name="btnMove" Content="Move" Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Width="80" Margin="5" Click="btnMove_Click"/>

                                <!-- Emergency Stop -->
                                <Button x:Name="btnEmergencyStop" Content="EMERGENCY STOP" Grid.Row="3" Grid.ColumnSpan="3" 
                                        Background="Red" Foreground="White" FontWeight="Bold" Margin="5" Click="btnEmergencyStop_Click"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- New ARUP Tab -->
            <TabItem Header="ARUP" Background="LightGreen">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Measurement Information -->
                        <GroupBox Header="Measurement Details" Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Venue:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                                <TextBox x:Name="txtArupVenue" Text="t2b.2f" Grid.Row="0" Grid.Column="1" Margin="5" MinWidth="80"/>

                                <TextBlock Text="Test Case:" Grid.Row="0" Grid.Column="2" Margin="5"/>
                                <TextBox x:Name="txtArupTestCase" Text="c8" Grid.Row="0" Grid.Column="3" Margin="5" MinWidth="80"/>

                                <TextBlock Text="Antenna Model:" Grid.Row="1" Grid.Column="0" Margin="5"/>
                                <TextBox x:Name="txtArupAntennaModel" Text="HE400-UWB" Grid.Row="1" Grid.Column="1" Margin="5" MinWidth="80"/>

                                <TextBlock Text="Position:" Grid.Row="1" Grid.Column="2" Margin="5"/>
                                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox x:Name="txtArupPositionPrefix" Text="A" Width="30" Margin="5,5,0,5"/>
                                    <TextBox x:Name="txtArupPositionNumber" Text="001" Width="50" Margin="0,5,5,5" 
                                             PreviewTextInput="NumberValidationTextBox"/>
                                </StackPanel>

                                <CheckBox x:Name="chkArupIncludeTimestamp" Content="Include Timestamp" Grid.Row="2" Grid.Column="2" Margin="5" IsChecked="False"/>
                            </Grid>
                        </GroupBox>

                        <!-- File Saving Options -->
                        <GroupBox Header="File Saving" Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="CSV Path:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbArupCsvPath" Grid.Row="0" Grid.Column="1" Margin="5" IsEditable="True">
                                    <ComboBoxItem Content="\Public\Datasets\" IsSelected="True"/>
                                    <ComboBoxItem Content="\USB\Datasets\" />
                                </ComboBox>

                                <TextBlock Text="PNG Path:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbArupPngPath" Grid.Row="1" Grid.Column="1" Margin="5" IsEditable="True">
                                    <ComboBoxItem Content="\Public\Screen Shots\" IsSelected="True"/>
                                    <ComboBoxItem Content="\USB\Screen Shots\" />
                                </ComboBox>
                            </Grid>
                        </GroupBox>

                        <!-- Measurement Controls -->
                        <GroupBox Header="Measurement Controls" Grid.Row="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="btnStartBackground" Content="(1) Start Background" Width="140" Margin="5" Click="btnStartBackground_Click"/>
                                <Button x:Name="btnBackgroundComplete" Content="Background Complete" Width="140" Margin="5" Click="btnBackgroundComplete_Click" IsEnabled="False"/>
                                <Button x:Name="btnStartSignal" Content="(2) Start Signal" Width="140" Margin="5" Click="btnStartSignal_Click" IsEnabled="False"/>
                                <Button x:Name="btnSignalComplete" Content="Signal Complete" Width="140" Margin="5" Click="btnSignalComplete_Click" IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Measurement Timer Display -->
                        <GroupBox Header="Measurement Time" Grid.Row="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtBackgroundTime" Text="Background: --:--" Grid.Column="0" Margin="5" FontWeight="Bold"/>
                                <TextBlock x:Name="txtSignalTime" Text="Signal: --:--" Grid.Column="1" Margin="5" FontWeight="Bold"/>
                            </Grid>
                        </GroupBox>

                        <!-- Measurement Log -->
                        <GroupBox Header="Measurement Log" Grid.Row="4">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnArupCopyLog" Content="Copy Log" Width="80" Margin="5" Click="btnArupCopyLog_Click"/>
                                    <Button x:Name="btnArupSaveLog" Content="Save Log" Width="80" Margin="5" Click="btnArupSaveLog_Click"/>
                                </StackPanel>
                                <TextBox x:Name="txtArupMeasurementLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                         TextWrapping="Wrap" Height="120"/>
                            </DockPanel>
                        </GroupBox>

                        <!-- Movement Control -->
                        <GroupBox Header="Movement Control" Grid.Row="5" Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Fine-Tune Movement -->
                                <TextBlock Text="Fine-Tune (cm):" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtArupFineTuneCm" Text="5" Grid.Row="0" Grid.Column="1" Width="50" Margin="5" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="btnArupMoveForwardCm" Content="Forward" Width="80" Margin="5" Click="btnMoveForwardCm_Click"/>
                                    <Button x:Name="btnArupMoveBackwardCm" Content="Backward" Width="80" Margin="5" Click="btnMoveBackwardCm_Click"/>
                                </StackPanel>

                                <!-- Distance Movement -->
                                <TextBlock Text="Distance (m):" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtArupMoveDistance" Text="1.0" Grid.Row="1" Grid.Column="1" Width="50" Margin="5" HorizontalAlignment="Left"/>

                                <TextBlock Text="Velocity (m/s):" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtArupMoveVelocity" Text="0.1" Grid.Row="2" Grid.Column="1" Width="50" Margin="5" HorizontalAlignment="Left"/>

                                <Button x:Name="btnArupMove" Content="Move" Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Width="80" Margin="5" Click="btnMove_Click"/>

                                <!-- Emergency Stop -->
                                <Button x:Name="btnArupEmergencyStop" Content="EMERGENCY STOP" Grid.Row="3" Grid.ColumnSpan="3" 
                                        Background="Red" Foreground="White" FontWeight="Bold" Margin="5" Click="btnEmergencyStop_Click"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10">
            <Button x:Name="btnReset" Content="Reset Instrument" Width="120" Margin="5" Click="btnReset_Click"/>
            <Button x:Name="btnApplySettings" Content="Apply Settings" Width="120" Margin="5" Click="btnApplySettings_Click"/>
            <Button x:Name="btnSetMarkers" Content="Set Markers" Width="120" Margin="5" Click="btnSetMarkers_Click"/>
        </StackPanel>

        <!-- Status Area -->
        <GroupBox Grid.Row="3" Header="Status and Log">
            <TextBox x:Name="txtStatus" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                     TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>